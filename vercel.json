{
  "framework": null,
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/osint",
      "destination": "/api/osint"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/osint.ts": {
      "maxDuration": 30
    }
  }
}
